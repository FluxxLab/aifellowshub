# Frontend .env — copy to `.env.local` (or `.env`) and adjust.
# `.env*` is gitignored, so values here never ship in commits.
#
# This file is committed AS A TEMPLATE. Don't put real secrets in it.

# ----------------------------------------------------------------
# Backend API URL
# ----------------------------------------------------------------
# Server-side only. Used by:
#   - `src/lib/api/backend.ts` (the BFF route handlers proxy to it)
#   - `src/lib/auth/getCurrentUser.ts` (server fetcher for /auth/me)
#
# Browsers never call this directly — they hit the local route handlers
# at `/api/*`, which forward server-side. So the URL is not a public
# value; we deliberately do NOT prefix with `NEXT_PUBLIC_` to keep it
# out of the client bundle.
#
# In Docker compose this is set to `http://backend:4000/api` because
# Compose resolves services by name. For native dev, point at wherever
# your backend is running.
BACKEND_API_URL="http://localhost:4000/api"

# ----------------------------------------------------------------
# Cloudflare Turnstile — bot protection on registration
# ----------------------------------------------------------------
# Public sitekey, intentionally `NEXT_PUBLIC_*` because Cloudflare
# expects it in the browser (the secret half lives on the backend).
# Leave empty to skip the widget locally — the backend also skips
# verification when its TURNSTILE_SECRET is empty, so dev keeps
# working with no Cloudflare account.
NEXT_PUBLIC_TURNSTILE_SITEKEY=""

# ----------------------------------------------------------------
# Legacy fallback (deprecated, will be removed)
# ----------------------------------------------------------------
# `getCurrentUser` and `backend.ts` still honour `NEXT_PUBLIC_API_URL`
# so older `.env`s keep working during the rollover. Drop it once
# you've moved to `BACKEND_API_URL`.
# NEXT_PUBLIC_API_URL="http://localhost:4000/api"
